# Django Configuration
SECRET_KEY=django-insecure-jobautoapply-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Default PostgreSQL settings. If PostgreSQL is not reachable, JobAutoApply falls back to SQLite automatically.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jobautoapply
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Or specify a full DATABASE_URL (optional)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobautoapply
